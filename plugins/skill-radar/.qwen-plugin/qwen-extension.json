{
  "name": "skill-radar",
  "version": "0.3.0",
  "description": "Skill observability for Qwen Code — tool invocation tracing, session tracking, and evolution signals.",
  "tool_selection": {
    "use_when": [
      "automatic tool tracing",
      "session correlation",
      "skill failure aggregation"
    ],
    "avoid_when": [
      "direct task execution",
      "blocking validation",
      "application logging replacement"
    ]
  },
  "capabilities": [
    "file-read",
    "file-write",
    "hooks",
    "env-access"
  ],
  "contextFileName": "QWEN.md",
  "excludeTools": [],
  "hooks": "hooks/hooks.json"
}
