<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <TargetFramework Condition="'$(Configuration)' == 'Debug'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(Configuration)' == 'Release'">net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="WorkspaceType.cs" />
    <Compile Include="Conditional\DebugOnly.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="$(GeneratedFile)" />
    <None Include="GeneratedTemplate.cs" />
  </ItemGroup>

  <Target Name="GenerateWorkspaceSource" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)Generated" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)GeneratedTemplate.cs" DestinationFiles="$(GeneratedFile)" />
  </Target>
</Project>
