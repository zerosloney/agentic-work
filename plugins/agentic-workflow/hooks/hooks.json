{
  "description": "Agentic Workflow — state write validation, forbidden-scope guard, verification gate",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/validate-state-write.js"],
            "timeoutMs": 5000,
            "statusMessage": "Agentic Workflow: validating state write…"
          },
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/block-forbidden-scope.js"],
            "timeoutMs": 5000,
            "statusMessage": "Agentic Workflow: checking forbidden_scope…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/check-verification-on-stop.js"],
            "timeoutMs": 5000,
            "statusMessage": "Agentic Workflow: checking verification before stop…"
          }
        ]
      }
    ]
  }
}
