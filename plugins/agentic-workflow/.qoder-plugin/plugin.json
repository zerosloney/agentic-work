{
  "name": "agentic-workflow-qoder",
  "version": "0.1.0",
  "description": "Orchestrated execute-review pipeline (Coding-Pipeline + Ralph-Pipeline/Ralph-Graph).",
  "tool_selection": { "use_when": ["multi-step coding task", "execute-review-fix loop", "task decomposition"], "avoid_when": ["single-step edit", "read-only explanation", "graph-specific unattended workflow"] },
  "capabilities": [
    "file-read",
    "file-write",
    "bash-exec",
    "hooks",
    "agents"
  ],
  "category": "workflow",
  "commands": "./commands",
  "agents": [
    "./agents/coding-builder.md",
    "./agents/coding-orchestrator.md",
    "./agents/coding-reviewer.md",
    "./agents/ralph-orchestrator.md",
    "./agents/ralph-reviewer.md",
    "./agents/ralph-worker.md"
  ],
  "hooks": "./hooks/hooks.json"
}
