{
  "name": "graph-workflow",
  "version": "0.2.0",
  "description": "Graph Workflow — Loop Engineering + Graph Engineering 闭环能力(命令编排 agent 有界循环 + 内层三角色 Task 协作) for Qoder.",
  "tool_selection": {
    "use_when": [
      "unattended long-running task",
      "execute-review-fix loop",
      "custom graph or DAG workflow"
    ],
    "avoid_when": [
      "interactive single-session coding",
      "single-step edit"
    ]
  },
  "capabilities": [
    "file-read",
    "file-write",
    "bash-exec",
    "hooks",
    "agents"
  ],
  "author": {
    "name": "master0071",
    "url": "https://github.com/zerosloney"
  },
  "homepage": "https://github.com/zerosloney/agentic-work",
  "repository": "https://github.com/zerosloney/agentic-work",
  "license": "MIT",
  "category": "workflow",
  "keywords": [
    "workflow",
    "loop",
    "graph",
    "orchestration"
  ],
  "commands": "./commands",
  "agents": [
    "./agents/executor.md",
    "./agents/fixer.md",
    "./agents/graph-orchestrator.md",
    "./agents/orchestrator.md",
    "./agents/reviewer.md"
  ],
  "hooks": "./hooks/hooks.json"
}
