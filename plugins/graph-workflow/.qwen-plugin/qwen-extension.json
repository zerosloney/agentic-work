{
  "name": "graph-workflow",
  "version": "0.2.0",
  "description": "Graph Workflow — Loop Engineering + Graph Engineering 闭环能力(命令编排 agent 有界循环 + 内层三角色 Task 协作) for Qwen Code.",
  "tool_selection": {
    "use_when": [
      "unattended long-running task",
      "execute-review-fix loop",
      "custom graph or DAG workflow"
    ],
    "avoid_when": [
      "interactive single-session coding",
      "single-step edit"
    ]
  },
  "capabilities": [
    "file-read",
    "file-write",
    "bash-exec",
    "hooks",
    "agents"
  ],
  "contextFileName": "QWEN.md",
  "excludeTools": [],
  "agents": "agents",
  "commands": "commands",
  "hooks": "hooks/hooks.json"
}
