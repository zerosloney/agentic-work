{
  "description": "Graph Workflow — state validation hooks (ZCode). type:process + ${ZCODE_PLUGIN_ROOT} + timeoutMs; declared by .zcode-plugin/plugin.json \"hooks\" field.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/validate-state-write.js"],
            "timeoutMs": 5000,
            "statusMessage": "Graph Workflow: validating state write…"
          }
        ]
      }
    ]
  }
}
