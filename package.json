{
  "name": "@master0071/agentic-work",
  "version": "0.1.0",
  "description": "Agentic-work plugins (dotnet-work + agentic-workflow + graph-workflow + skill-radar) for ZCode, CodeBuddy, Trae, Qoder, Qwen Code.",
  "license": "MIT",
  "author": {
    "name": "master0071",
    "url": "https://github.com/zerosloney"
  },
  "homepage": "https://github.com/zerosloney/agentic-work",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerosloney/agentic-work.git"
  },
  "engines": { "node": ">=18" },
  "bin": {
    "agentic-work-codebuddy": "scripts/install-codebuddy.js",
    "agentic-work": "scripts/install-zcode.js",
    "agentic-work-claude": "scripts/install-claude.js"
  },
  "scripts": {
    "install:codebuddy": "node ./scripts/install-codebuddy.js",
    "install:zcode": "node ./scripts/install-zcode.js",
    "install:claude": "node ./scripts/install-claude.js",
    "install:all": "node ./scripts/install-codebuddy.js && node ./scripts/install-zcode.js && node ./scripts/install-claude.js",
    "verify": "node ./scripts/install-codebuddy.js --dry-run && node ./scripts/install-zcode.js --dry-run && node ./scripts/install-claude.js --dry-run",
    "validate-state": "node ./scripts/validate-state.js",
    "test:agentic-workflow": "node ./scripts/test-agentic-workflow.js"
  },
  "files": [
    "plugins/",
    "scripts/",
    "marketplace.json",
    ".codebuddy-plugin/marketplace.json",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ]
}
